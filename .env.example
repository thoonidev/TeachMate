# Configure these in the environment of the process that starts Tomcat.
# This file is an example; the application does not automatically load .env files.
DB_URL=jdbc:mysql://localhost:3306/teachmateweb?connectionTimeZone=UTC&connectTimeout=10000&socketTimeout=30000
DB_USER=teachmate_app
DB_PASSWORD=replace_with_your_password
ADMIN_EMAIL=admin@example.com
# Generate with PasswordTool hash. Never put the raw password here.
ADMIN_PASSWORD_HASH=replace_with_generated_hash
# false for localhost over HTTP; true for Render over HTTPS.
SESSION_COOKIE_SECURE=false
# Only true for a public Render service behind its trusted proxy.
TRUST_RENDER_PROXY=false
# For a remote database, use the provider's hostname, port and database name.
# Add sslMode=VERIFY_IDENTITY and configure the provider's CA trust when required.
