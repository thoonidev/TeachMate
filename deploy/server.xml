<?xml version="1.0" encoding="UTF-8"?>
<Server port="-1">
    <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
    <Service name="Catalina">
        <Connector address="0.0.0.0" port="${http.port}" protocol="HTTP/1.1"
                   connectionTimeout="20000" maxThreads="40" maxParameterCount="100"
                   maxPostSize="2097152" maxSwallowSize="6291456" URIEncoding="UTF-8" server="TeachMate" />
        <Engine name="Catalina" defaultHost="localhost">
            <Host name="localhost" appBase="webapps" unpackWARs="false" autoDeploy="false">
                <!-- Default internalProxies trusts private/loopback hops only, not every caller. -->
                <Valve className="org.apache.catalina.valves.RemoteIpValve"
                       remoteIpHeader="${proxy.remoteHeader}"
                       protocolHeader="${proxy.protocolHeader}"
                       protocolHeaderHttpsValue="https" requestAttributesEnabled="true" />
                <Valve className="org.apache.catalina.valves.ErrorReportValve"
                       showReport="false" showServerInfo="false" />
            </Host>
        </Engine>
    </Service>
</Server>
