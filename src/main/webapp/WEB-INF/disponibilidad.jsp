<%@ page pageEncoding="UTF-8" %>
<section class="card"><div class="card-body"><h2 class="tm-section-title">Disponibilidad por fecha</h2><p class="text-muted small">Añade franjas en hora de Lima. No se repiten automáticamente cada semana. Retirar una franja impide nuevas reservas y conserva las asesorías ya registradas.</p>
<form class="row g-3 mb-4" method="post" action="${pageContext.request.contextPath}<%=disponibilidadAction%>"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="docenteId" value="<%=ofertaDocenteId%>"><input type="hidden" name="accion" value="agregar">
<div class="col-md-4"><label class="form-label" for="fecha">Fecha</label><input class="form-control" id="fecha" name="fecha" type="date" min="<%=java.time.LocalDate.now(com.tme.service.ReglasTutoria.ZONA)%>" required></div>
<div class="col-md-4"><label class="form-label" for="desde">Desde</label><input class="form-control" id="desde" name="desde" type="time" required></div><div class="col-md-4"><label class="form-label" for="hasta">Hasta</label><input class="form-control" id="hasta" name="hasta" type="time" required></div><div class="col-12"><button class="btn btn-primary" type="submit">Añadir franja</button></div></form>
<div class="tm-offer-items"><% var franjas=oferta.franjas(ofertaDocenteId);if(franjas.isEmpty()){ %><p class="tm-empty">No hay disponibilidad publicada. Añade una fecha y un intervalo de horas.</p><% }for(var franja:franjas){ %><div class="tm-offer-item"><div><strong><%=franja.fecha()%></strong><span><%=franja.desde()%> a <%=franja.hasta()%> · Lima</span></div><form method="post" action="${pageContext.request.contextPath}<%=disponibilidadAction%>"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="docenteId" value="<%=ofertaDocenteId%>"><input type="hidden" name="franjaId" value="<%=franja.id()%>"><input type="hidden" name="accion" value="retirar"><button class="btn btn-outline-danger btn-sm" type="submit">Retirar franja</button></form></div><% } %></div>
</div></section>
