<%@ page pageEncoding="UTF-8" %>
<%@ page import="com.tme.dao.*,com.tme.db.DBConnection,com.tme.modal.Docente,com.tme.service.ReglasTutoria,com.tme.service.ReglasTutoria.Rol,com.tme.security.Html,java.time.*,java.util.*" %>
<%!
private String diaIngreso(int d){return DayOfWeek.of(d).getDisplayName(java.time.format.TextStyle.FULL,Locale.forLanguageTag("es-PE"));}
private String fechaIngreso(LocalDateTime f){return f==null?"—":f.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"));}
%>
<%
boolean ingresosAdmin=session.getAttribute("adminObj")!=null;Rol ingresosRol=ingresosAdmin?Rol.ADMIN:Rol.DOCENTE;
int ingresosActor=ingresosAdmin?0:((Docente)session.getAttribute("docenteObj")).getId(),ingresosProfesor=ingresosActor,ingresosPagina=1;
try{if(ingresosAdmin&&request.getParameter("docente")!=null)ingresosProfesor=Integer.parseInt(request.getParameter("docente"));if(request.getParameter("pagina")!=null)ingresosPagina=Math.max(1,Integer.parseInt(request.getParameter("pagina")));}catch(RuntimeException e){response.sendError(400);return;}
var ingresosDao=new LiquidacionesDAO(DBConnection.getConn());var calendarioIngreso=new ConfiguracionLiquidacionesDAO(DBConnection.getConn()).obtener();
var profesoresIngreso=new DocenteDAO(DBConnection.getConn()).getAllDocente();Docente profesorIngreso=null;for(var p:profesoresIngreso)if(p.getId()==ingresosProfesor)profesorIngreso=p;
if(ingresosProfesor!=0&&profesorIngreso==null){response.sendError(404);return;}
String ingresoCtx=request.getContextPath(),ingresoCsrf=(String)session.getAttribute("csrfToken"),corteIngreso=request.getParameter("corte");
if(corteIngreso==null&&calendarioIngreso.completa())corteIngreso=calendarioIngreso.ultimoCorte(ReglasTutoria.ahora().toLocalDate()).toString();
LiquidacionesDAO.Vista vistaIngreso=null;String errorIngreso=null;
if(ingresosAdmin&&ingresosProfesor>0&&calendarioIngreso.completa())try{vistaIngreso=ingresosDao.preparar(ingresosProfesor,corteIngreso,0,Rol.ADMIN);}catch(IllegalArgumentException e){errorIngreso=e.getMessage();}
%>
<div class="container p-3"><div class="tm-page-heading"><div><p class="tm-eyebrow"><%=ingresosAdmin?"Organización del equipo":"Tu trabajo como profesor"%></p><h1 class="tm-page-title"><%=ingresosAdmin?"Liquidaciones":"Mis ingresos"%></h1><p><%=ingresosAdmin?"Prepara el cierre, revisa sus sesiones y registra la transferencia realizada fuera del sistema.":"Consulta lo generado por tus asesorías, tus cierres y las transferencias registradas."%></p></div></div>
<% if(ingresosAdmin){var recaudacion=ingresosDao.recaudacion(Rol.ADMIN); %>
<div class="tm-metrics mb-4"><div class="tm-metric"><span>Ingresos de alumnos validados</span><strong>S/ <%=recaudacion.ingreso()%></strong><small>Acumulado del equipo</small></div><div class="tm-metric"><span>Devoluciones realizadas</span><strong>S/ <%=recaudacion.devolucion()%></strong><small>Transferencias registradas a alumnos</small></div><div class="tm-metric"><span>Transferido a profesores</span><strong>S/ <%=recaudacion.transferido()%></strong><small>Liquidaciones con transferencia registrada</small></div></div><p class="form-text">Estos movimientos no representan utilidad neta ni saldo bancario. La retención del equipo también cubre operación; no es automáticamente sueldo del administrador.</p>
<details class="card mb-4"><summary class="card-body">Calendario semanal <%=calendarioIngreso.completa()?"· corte: "+diaIngreso(calendarioIngreso.corte())+"; pago: "+diaIngreso(calendarioIngreso.pago()):"· pendiente de configurar"%></summary><div class="card-body pt-0"><form action="<%=ingresoCtx%>/gestionarLiquidacion" method="post" class="row g-3"><input type="hidden" name="csrfToken" value="<%=Html.escape(ingresoCsrf)%>"><input type="hidden" name="accion" value="configurar"><div class="col-md-5"><label class="form-label" for="corte-dia">Día de corte</label><select class="form-select" id="corte-dia" name="corteDia" required><option value="">Selecciona un día</option><% for(int d=1;d<=7;d++){ %><option value="<%=d%>" <%=Objects.equals(calendarioIngreso.corte(),d)?"selected":""%>><%=diaIngreso(d)%></option><% } %></select></div><div class="col-md-5"><label class="form-label" for="pago-dia">Día previsto de transferencia</label><select class="form-select" id="pago-dia" name="pagoDia" required><option value="">Selecciona un día distinto</option><% for(int d=1;d<=7;d++){ %><option value="<%=d%>" <%=Objects.equals(calendarioIngreso.pago(),d)?"selected":""%>><%=diaIngreso(d)%></option><% } %></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary" type="submit">Guardar</button></div><p class="form-text">El corte incluye el día completo y las sesiones aptas de cortes anteriores que sigan pendientes. No ejecuta transferencias automáticas. Los cierres existentes conservan su calendario.</p></form></div></details>
<% if(!calendarioIngreso.completa()){ %><p class="alert alert-info">Configura ambos días para habilitar la preparación de cierres. No hay días de ejemplo activos.</p><% } %>
<section class="card mb-4"><div class="card-body"><form method="get" class="row g-3 align-items-end"><div class="col-md-6"><label class="form-label" for="profesor-ingreso">Profesor</label><select class="form-select" id="profesor-ingreso" name="docente"><option value="0">Ver todo el equipo</option><% for(var p:profesoresIngreso){ %><option value="<%=p.getId()%>" <%=p.getId()==ingresosProfesor?"selected":""%>><%=Html.escape(p.getNombre())%><%=p.isActivo()?"":" (inactivo)"%></option><% } %></select></div><div class="col-md-4"><label class="form-label" for="corte-ingreso">Hasta el corte</label><input class="form-control" id="corte-ingreso" name="corte" type="date" max="<%=ReglasTutoria.ahora().toLocalDate().minusDays(1)%>" value="<%=Html.escape(corteIngreso)%>"></div><div class="col-md-2"><button class="btn btn-primary" type="submit">Consultar</button></div></form></div></section>
<% if(ingresosProfesor==0){ %><div class="tm-payment-cards"><% for(var p:profesoresIngreso){var r=ingresosDao.resumen(p.getId(),0,Rol.ADMIN); %><section class="card"><div class="card-body"><h2 class="tm-section-title"><%=Html.escape(p.getNombre())%></h2><p>Disponible para cierre: <strong>S/ <%=r.disponible()%></strong><br>En cierres pendientes: S/ <%=r.pendiente()%><br>Transferido: S/ <%=r.pagado()%></p><% if(r.ajustes()>0){ %><p class="alert alert-info"><%=r.ajustes()%> ajustes requieren revisión.</p><% } %><a class="btn btn-outline-primary" href="?docente=<%=p.getId()%>">Revisar ingresos y cierres</a></div></section><% } %></div><% } %>
<% } %>
<% if(profesorIngreso!=null){var resumenIngreso=ingresosDao.resumen(ingresosProfesor,ingresosActor,ingresosRol); %><h2 class="tm-section-title"><%=Html.escape(profesorIngreso.getNombre())%></h2><div class="tm-metrics mb-4"><div class="tm-metric"><span>Generado neto</span><strong>S/ <%=resumenIngreso.generado()%></strong><small>Incluye ajustes aceptados</small></div><div class="tm-metric"><span>Disponible para cierre</span><strong>S/ <%=resumenIngreso.disponible()%></strong><small>Sesiones aptas y ajustes sin asignar</small></div><div class="tm-metric"><span>En cierres pendientes</span><strong>S/ <%=resumenIngreso.pendiente()%></strong><small>Todavía sin transferencia</small></div><div class="tm-metric"><span>Transferido</span><strong>S/ <%=resumenIngreso.pagado()%></strong><small>Pagos externos registrados</small></div></div><p class="form-text">Una sesión genera remuneración cuando está realizada, pagada y sin asuntos pendientes. No se incluyen registros anteriores sin tarifa o reparto verificable. Un disponible negativo es un ajuste aceptado por compensar con sesiones futuras; no es una transferencia ni un cobro automático.</p>
<% if(errorIngreso!=null){ %><p class="alert alert-warning"><%=Html.escape(errorIngreso)%></p><% } %>
<% if(vistaIngreso!=null){ %><section class="card mb-4"><div class="card-body"><h2 class="tm-section-title">Revisión del cierre hasta <%=Html.escape(corteIngreso)%></h2><p class="form-text">La sesión aporta el precio original × el porcentaje del profesor, redondeado a dos decimales. Las devoluciones se muestran por separado y solo reducen este cierre si existe un ajuste aceptado.</p><% if(vistaIngreso.lineas().isEmpty()){ %><p>No hay sesiones o ajustes aptos para este corte. No corresponde generar un pago vacío.</p><% }else{ %><ul class="tm-payment-list"><% for(var l:vistaIngreso.lineas()){ %><li><strong><%=l.tipo()%> · Asesoría #<%=l.tutoria()%> · <%=Html.escape(l.curso())%> · S/ <%=l.importe()%></strong><p class="form-text">Fecha: <%=l.fecha()%> · Precio S/ <%=l.precio()%> · Reparto <%=l.porcentaje()%> % · Devoluciones registradas S/ <%=l.devuelto()%><br><%=Html.escape(l.descripcion())%></p></li><% } %></ul><p class="tm-payment-state">Total del cierre: S/ <%=vistaIngreso.total()%></p><% if(vistaIngreso.total().signum()>=0){ %><form method="post" action="<%=ingresoCtx%>/gestionarLiquidacion"><input type="hidden" name="csrfToken" value="<%=Html.escape(ingresoCsrf)%>"><input type="hidden" name="accion" value="crear"><input type="hidden" name="docente" value="<%=ingresosProfesor%>"><input type="hidden" name="corte" value="<%=Html.escape(corteIngreso)%>"><input type="hidden" name="huella" value="<%=vistaIngreso.huella()%>"><button class="btn btn-primary" type="submit">Confirmar detalle y crear cierre pendiente</button></form><% }else{ %><p class="alert alert-info">El ajuste aceptado se conserva hasta contar con ingresos suficientes para compensarlo.</p><% } %><% } %><% if(!vistaIngreso.retenidas().isEmpty()){ %><details class="tm-action-details"><summary>Sesiones excluidas de este cierre (<%=vistaIngreso.retenidas().size()%>)</summary><ul><% for(var x:vistaIngreso.retenidas()){ %><li>Asesoría #<%=x.id()%>: <%=Html.escape(x.motivo())%></li><% } %></ul></details><% } %></div></section><% } %>
<% var disponibleIngreso=ingresosDao.disponiblesProfesor(ingresosProfesor,ingresosActor,ingresosRol); %><section class="card mb-4"><div class="card-body"><h2 class="tm-section-title">Detalle pendiente de cierre</h2><% if(disponibleIngreso.lineas().isEmpty()){ %><p class="text-muted">No hay sesiones o ajustes disponibles en este momento.</p><% } %><ul class="tm-payment-list"><% for(var l:disponibleIngreso.lineas()){ %><li><strong><%=l.tipo()%> · <%=Html.escape(l.curso())%> · S/ <%=l.importe()%></strong><p class="form-text">Asesoría #<%=l.tutoria()%> · <%=l.fecha()%> · Precio S/ <%=l.precio()%> × <%=l.porcentaje()%> %<br><%=Html.escape(l.descripcion())%></p></li><% } %></ul><% if(!disponibleIngreso.retenidas().isEmpty()){ %><details class="tm-action-details"><summary>Sesiones retenidas o sin requisitos completos (<%=disponibleIngreso.retenidas().size()%>)</summary><ul><% for(var x:disponibleIngreso.retenidas()){ %><li>Asesoría #<%=x.id()%>: <%=Html.escape(x.motivo())%></li><% } %></ul></details><% } %></div></section>
<section class="card mb-4"><div class="card-body"><h2 class="tm-section-title">Cierres y transferencias</h2><% var cierresIngreso=ingresosDao.listar(ingresosProfesor,ingresosActor,ingresosRol,ingresosPagina);if(cierresIngreso.isEmpty()){ %><p class="text-muted">Todavía no hay cierres para este profesor. Si no realiza asesorías aptas, no genera remuneración por sesiones.</p><% } %><ul class="tm-payment-list"><% for(var l:cierresIngreso.subList(0,Math.min(20,cierresIngreso.size()))){ %><li><strong>Cierre #<%=l.id()%> · <%=l.estado()%> · S/ <%=l.total()%></strong><p>Corte: <%=l.corte()%> · Pago previsto: <%=l.previsto()%><% if(l.estado().equals("Pendiente")&&l.previsto().isBefore(ReglasTutoria.ahora().toLocalDate())){ %> · <strong>Fecha prevista superada</strong><% } %></p><a href="<%=ingresoCtx%>/liquidacion.jsp?id=<%=l.id()%>">Ver detalle y transferencia</a></li><% } %></ul><nav aria-label="Páginas de cierres"><% if(ingresosPagina>1){ %><a class="btn btn-outline-secondary" href="?docente=<%=ingresosProfesor%>&amp;pagina=<%=ingresosPagina-1%>">Anterior</a><% } %><% if(cierresIngreso.size()>20){ %><a class="btn btn-outline-secondary" href="?docente=<%=ingresosProfesor%>&amp;pagina=<%=ingresosPagina+1%>">Siguiente</a><% } %></nav></div></section>
<section class="card"><div class="card-body"><h2 class="tm-section-title">Ajustes por devoluciones</h2><p class="form-text">Una devolución no cambia transferencias anteriores. Administración puede asumir el costo o proponer un ajuste al profesor. Un ajuste negativo requiere su aceptación antes de incorporarse a otro cierre.</p><% var ajustesIngreso=ingresosDao.ajustes(ingresosProfesor,ingresosActor,ingresosRol);if(ajustesIngreso.isEmpty()){ %><p class="text-muted">No hay ajustes registrados.</p><% } %>
<% for(var a:ajustesIngreso){ %><details class="tm-action-details"><summary>Ajuste #<%=a.id()%> · Asesoría #<%=a.tutoria()%> · <%=a.estado()%><%=a.importe()==null?"":" · S/ "+a.importe()%></summary><p>Devolución #<%=a.devolucion()%> · Límite proporcional del ajuste: S/ <%=a.sugerido()%></p><% if(a.origen()!=null){ %><p><a href="<%=ingresoCtx%>/liquidacion.jsp?id=<%=a.origen()%>">Consultar cierre original #<%=a.origen()%></a></p><% } %><p><%=Html.escape(a.motivo())%></p><p class="form-text"><%=Html.escape(a.respuesta())%></p>
<% if(ingresosAdmin&&Set.of("Pendiente","Propuesto","En revisión").contains(a.estado())){ %><form method="post" action="<%=ingresoCtx%>/gestionarAjuste"><input type="hidden" name="csrfToken" value="<%=Html.escape(ingresoCsrf)%>"><input type="hidden" name="id" value="<%=a.id()%>"><input type="hidden" name="version" value="<%=a.version()%>"><input type="hidden" name="accion" value="proponer"><label class="form-label" for="importe-ajuste-<%=a.id()%>">Ajuste propuesto (S/): cero si lo asume el equipo</label><input class="form-control mb-3" id="importe-ajuste-<%=a.id()%>" name="importe" type="number" step="0.01" min="<%=a.sugerido()%>" max="0" required><label class="form-label" for="motivo-ajuste-<%=a.id()%>">Motivo y acuerdo propuesto</label><textarea class="form-control mb-3" id="motivo-ajuste-<%=a.id()%>" name="motivo" maxlength="850" required></textarea><button class="btn btn-outline-primary" type="submit">Registrar decisión o enviar propuesta</button></form><% } %>
<% if(!ingresosAdmin&&a.estado().equals("Propuesto")){ %><form method="post" action="<%=ingresoCtx%>/gestionarAjuste"><input type="hidden" name="csrfToken" value="<%=Html.escape(ingresoCsrf)%>"><input type="hidden" name="id" value="<%=a.id()%>"><input type="hidden" name="version" value="<%=a.version()%>"><label class="form-label" for="respuesta-ajuste-<%=a.id()%>">Tu respuesta</label><textarea class="form-control mb-3" id="respuesta-ajuste-<%=a.id()%>" name="motivo" maxlength="850" required></textarea><button class="btn btn-primary" type="submit" name="accion" value="aceptar">Aceptar ajuste de S/ <%=a.importe()%></button> <button class="btn btn-outline-secondary" type="submit" name="accion" value="revisar">Solicitar revisión</button></form><% } %>
<ol class="tm-session-history mt-3"><% for(var e:ingresosDao.historial(0,a.id(),ingresosActor,ingresosRol)){ %><li><span><%=fechaIngreso(e.fecha())%> (Lima) · <%=e.rol().equals("ADMIN")?"Administración":e.rol().equals("DOCENTE")?"Profesor":"Sistema"%></span><p><%=Html.escape(e.detalle())%></p></li><% } %></ol></details><% } %></div></section><% } %></div>
