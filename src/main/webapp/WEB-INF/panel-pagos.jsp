<%@ page pageEncoding="UTF-8" %>
<%@ page import="com.tme.dao.PagosDAO,com.tme.db.DBConnection,com.tme.modal.User,com.tme.service.ReglasTutoria,com.tme.service.ReglasTutoria.Rol,com.tme.security.Html,java.net.URLEncoder,java.nio.charset.StandardCharsets" %>
<%
boolean panelAdmin=session.getAttribute("adminObj")!=null;Rol panelPagoRol=panelAdmin?Rol.ADMIN:Rol.ALUMNO;int panelPagoActor=panelAdmin?0:((User)session.getAttribute("userObj")).getId();
String filtroPago=request.getParameter("estado");if(filtroPago==null)filtroPago=panelAdmin?"Por atender":"Todos";
int numeroPago=1;try{numeroPago=Integer.parseInt(request.getParameter("pagina"));}catch(RuntimeException ignored){}
PagosDAO.Pagina paginaPago;try{paginaPago=new PagosDAO(DBConnection.getConn()).listar(panelPagoActor,panelPagoRol,filtroPago,numeroPago);}catch(IllegalArgumentException e){response.sendError(400);return;}
String estadoUrl=URLEncoder.encode(filtroPago,StandardCharsets.UTF_8);
%>
<div class="container p-3"><div class="tm-page-heading"><div><p class="tm-eyebrow"><%=panelAdmin?"Control de ingresos":"Tu cuenta"%></p><h1 class="tm-page-title"><%=panelAdmin?"Pagos de alumnos":"Mis pagos"%></h1><p><%=panelAdmin?"Verifica los ingresos en la cuenta del equipo y resuelve observaciones y devoluciones.":"Consulta tus comprobantes, la confirmación del ingreso y las devoluciones."%></p></div><% if(panelAdmin){ %><a class="btn btn-outline-secondary" href="configuracion.jsp#cobros">Configurar cobro</a><% } %></div>
<section class="card mb-4"><div class="card-body"><form method="get" class="row g-3 align-items-end"><div class="col-md-8"><label class="form-label" for="estado-pago">Mostrar pagos</label><select class="form-select" name="estado" id="estado-pago"><% for(String estado:java.util.List.of("Por atender","Todos","En revisión","Observado","Validado","Devolución pendiente","Devuelto")){ %><option <%=estado.equals(filtroPago)?"selected":""%>><%=estado%></option><% } %></select></div><div class="col-md-4"><button class="btn btn-primary" type="submit">Consultar</button></div></form></div></section>
<% if(panelAdmin){ %><section class="card mb-4"><div class="card-body"><form action="../pago.jsp" method="get" class="row g-3 align-items-end"><div class="col-md-8"><label class="form-label" for="buscar-reserva">Consultar por número de asesoría</label><input class="form-control" id="buscar-reserva" name="id" type="number" min="1" required></div><div class="col-md-4"><button class="btn btn-outline-primary" type="submit">Abrir pago</button></div></form></div></section><% } %>
<p class="form-text"><%=paginaPago.total()%> resultados · Página <%=paginaPago.pagina()%> de <%=paginaPago.paginas()%>. Los horarios corresponden a Lima.</p>
<% if(paginaPago.filas().isEmpty()){ %><section class="card"><div class="card-body"><h2 class="tm-section-title">No hay pagos en esta vista</h2><p class="text-muted">Los pagos se habilitan cuando el profesor acepta la solicitud. Las reservas cerradas sin ingreso no generan una deuda.</p></div></section><% } %>
<div class="tm-payment-cards"><% for(var fila:paginaPago.filas()){ %><article class="card"><div class="card-body"><p class="tm-eyebrow">Asesoría #<%=fila.id()%></p><h2 class="tm-section-title"><%=Html.escape(fila.curso()==null?"Asesoría individual":fila.curso())%></h2><% if(panelAdmin){ %><p><%=Html.escape(fila.alumno())%></p><% } %><p><strong><%=Html.escape(fila.pago()==null?"Pendiente de registro":fila.pago())%></strong> · <%=fila.importe()==null?"Sin tarifa histórica":"S/ "+fila.importe()%></p><p class="form-text">Sesión: <%=Html.escape(fila.sesion())%><br><%=fila.inicio()==null?"Horario por definir":fila.inicio().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))+" (Lima)"%></p>
<% if(fila.solicitud()){ %><p class="alert alert-info">Solicitud de cancelación o devolución por revisar.</p><% } %>
<% if(panelAdmin&&"En revisión".equals(fila.pago())&&(fila.sesion().equals("Incidencia")||(fila.enviado()!=null&&fila.enviado().isBefore(ReglasTutoria.ahora().minusHours(1)))||(fila.inicio()!=null&&fila.inicio().isBefore(ReglasTutoria.ahora().plusHours(2))))){ %><p class="alert alert-warning">Revisión prioritaria por demora o proximidad de la clase.</p><% } %>
<% if(panelAdmin&&"Validado".equals(fila.pago())&&java.util.Set.of("Cancelada","Vencida","Rechazada","Incidencia").contains(fila.sesion())){ %><p class="alert alert-warning">Revisar el destino del ingreso de esta sesión.</p><% } %>
<a class="btn btn-primary" href="${pageContext.request.contextPath}/pago.jsp?id=<%=fila.id()%>"><%=panelAdmin?"Revisar pago":"Ver mi pago"%></a></div></article><% } %></div>
<nav class="tm-pagination mt-4" aria-label="Páginas de pagos"><% if(paginaPago.pagina()>1){ %><a class="btn btn-outline-secondary" href="?estado=<%=estadoUrl%>&amp;pagina=<%=paginaPago.pagina()-1%>">Anterior</a><% } %><% if(paginaPago.pagina()<paginaPago.paginas()){ %><a class="btn btn-outline-secondary" href="?estado=<%=estadoUrl%>&amp;pagina=<%=paginaPago.pagina()+1%>">Siguiente</a><% } %></nav></div>
