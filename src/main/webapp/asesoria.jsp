<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.tme.dao.GestionAsesoriasDAO,com.tme.dao.PagosDAO,com.tme.db.DBConnection,com.tme.modal.*,com.tme.service.ReglasTutoria,com.tme.service.ReglasTutoria.Rol,com.tme.security.Html,java.util.*" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%!
private String abrirAccion(String contexto,int id,String accion,String csrf){return "<form method=\"post\" action=\""+Html.escape(contexto)+"/gestionarAsesoria\"><input type=\"hidden\" name=\"csrfToken\" value=\""+Html.escape(csrf)+"\"><input type=\"hidden\" name=\"id\" value=\""+id+"\"><input type=\"hidden\" name=\"accion\" value=\""+accion+"\">";}
private String motivoAccion(String accion,String etiqueta,Map<String,String> datos,int max){String valor=accion.equals(datos.get("accion"))?datos.getOrDefault("motivo",""):"";return "<label class=\"form-label\" for=\"motivo-"+accion+"\">"+Html.escape(etiqueta)+"</label><textarea class=\"form-control mb-3\" id=\"motivo-"+accion+"\" name=\"motivo\" required maxlength=\""+max+"\" rows=\"3\">"+Html.escape(valor)+"</textarea>";}
private String rolEvento(String rol){return switch(rol){case "ADMIN"->"Administración";case "DOCENTE"->"Profesor";case "ALUMNO"->"Alumno";default->"Sistema";};}
private String tituloAccion(String accion,boolean solicitud){return switch(accion){case "enlace"->"Publicar o cambiar enlace de clase";case "proponer"->"Proponer otra fecha y hora";case "completar"->"Registrar asesoría realizada";case "comentario"->"Actualizar seguimiento";case "incidencia"->"Reportar inasistencia o problema";case "resolver"->"Resolver incidencia";case "cancelar"->solicitud?"Solicitar cancelación":"Cancelar asesoría";case "mantener"->"No aprobar cancelación o devolución";default->"Gestionar asesoría";};}
%>
<%
int asesoriaId;try{asesoriaId=Integer.parseInt(request.getParameter("id"));if(asesoriaId<1)throw new NumberFormatException();}catch(RuntimeException e){response.sendError(400);return;}
Rol actorRol=session.getAttribute("adminObj")!=null?Rol.ADMIN:session.getAttribute("docenteObj")!=null?Rol.DOCENTE:Rol.ALUMNO;
int actorId=actorRol==Rol.ADMIN?0:actorRol==Rol.DOCENTE?((Docente)session.getAttribute("docenteObj")).getId():((User)session.getAttribute("userObj")).getId();
GestionAsesoriasDAO gestion=new GestionAsesoriasDAO(DBConnection.getConn());Tutoria asesoria=gestion.obtener(asesoriaId,actorId,actorRol);
if(asesoria==null){response.sendError(404);return;}
var acciones=GestionAsesoriasDAO.acciones(asesoria,actorRol,ReglasTutoria.ahora());var cambio=gestion.cambio(asesoriaId);var eventos=gestion.historial(asesoriaId);var estadoPago=new PagosDAO(DBConnection.getConn()).obtener(asesoriaId);
String contexto=request.getContextPath(),csrf=(String)session.getAttribute("csrfToken");
String regreso=actorRol==Rol.ADMIN?"/admin/alumno.jsp":actorRol==Rol.DOCENTE?"/docente/alumno.jsp":"/list_tutoria.jsp";
Map<String,String> accionDatos=new HashMap<>();Object datosPrevios=session.getAttribute("asesoriaForm");session.removeAttribute("asesoriaForm");
if(datosPrevios instanceof Map<?,?> mapa&&Integer.toString(asesoriaId).equals(mapa.get("id")))for(var entrada:mapa.entrySet())if(entrada.getKey() instanceof String clave&&entrada.getValue() instanceof String valor)accionDatos.put(clave,valor);
boolean solicitarCancelacion=actorRol==Rol.ALUMNO&&(ReglasTutoria.confirmada(asesoria)||asesoria.isPagoRevision());
%>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Asesoría #<%=asesoriaId%> | TeachMate</title><%@ include file="component/allcss.jsp" %></head><body><%@ include file="component/navbar.jsp" %>
<main id="contenido" class="tm-main" tabindex="-1"><%@ include file="component/messages.jsp" %><div class="container p-3">
<div class="tm-page-heading"><div><p class="tm-eyebrow">Detalle y seguimiento · #<%=asesoriaId%></p><h1 class="tm-page-title"><%=Html.escape(asesoria.getCursoNombre()==null?"Asesoría individual":asesoria.getCursoNombre())%></h1><p><%=Html.escape(asesoria.getExperiencia())%></p></div><a class="btn btn-outline-secondary" href="<%=contexto+regreso%>">Volver a mis asesorías</a></div>
<div class="tm-session-layout"><div>
<section class="card mb-4"><div class="card-body"><span class="tm-status tm-status-<%=EstadoTutoria.desdeValor(asesoria.getEstado()).getClase()%>"><%=EstadoTutoria.desdeValor(asesoria.getEstado()).getEtiqueta()%></span>
<h2 class="tm-section-title mt-4">Fecha y participantes</h2><dl class="tm-session-summary"><dt>Horario de Lima</dt><dd><%=Html.escape(asesoria.getFtutoria())%> · <%=Html.escape(asesoria.getHorario())%></dd><dt>Alumno</dt><dd><%=Html.escape(asesoria.getNombre())%></dd><dt>Profesor</dt><dd><%=Html.escape(new com.tme.dao.DocenteDAO(DBConnection.getConn()).getDocenteById(asesoria.getDocenteId()).getNombre())%></dd><dt>Nivel</dt><dd><%=asesoria.getNivel().isBlank()?"Sin nivel registrado":Html.escape(asesoria.getNivel())%></dd><dt>Precio de la asesoría</dt><dd><%=asesoria.getPrecio()==null?"Registro anterior sin tarifa":"S/ "+asesoria.getPrecio()%></dd><dt>Contacto del alumno</dt><dd><%=Html.escape(asesoria.getEmail())%><br><%=Html.escape(asesoria.getTelefono())%></dd></dl>
<% if(actorRol!=Rol.ALUMNO&&asesoria.getPorcentajeDocente()!=null){ %><p class="form-text">Reparto acordado para el profesor: <%=asesoria.getPorcentajeDocente()%> %. La remuneración se determina con la sesión realizada, el ingreso validado y la resolución de cualquier incidencia.</p><% } %>
<% if(asesoria.getEstado().equals("Pendiente")&&asesoria.getVenceRespuesta()!=null){ %><p class="alert alert-info">Registro anterior con plazo de respuesta hasta <strong><%=asesoria.getVenceRespuesta()%></strong> (Lima). Las nuevas reservas pasan directamente a pendiente de pago.</p><% } %>
<% if(asesoria.getEstado().equals("Pendiente de pago")){ %><p class="alert alert-info">El horario publicado está reservado. <% if(asesoria.isPagoRevision()){ %>El comprobante está en revisión. El horario se conserva hasta el inicio de la clase mientras administración verifica el ingreso.<% }else{ %>Envía el comprobante antes de <strong><%=asesoria.getVencePago()%></strong> (Lima).<% } %> La asesoría aún no está confirmada.</p><% } %>
<% if(asesoria.getEstado().equals("Pendiente de pago")&&asesoria.getRevisionPrevista()!=null){ %><p class="alert <%=asesoria.isPagoRevision()&&!ReglasTutoria.ahora().isBefore(asesoria.getRevisionPrevista())?"alert-warning":"alert-info"%>">Revisión administrativa prevista a más tardar: <strong><%=asesoria.getRevisionPrevista().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))%></strong> (Lima), si el comprobante se envía dentro del plazo. Esta fecha no confirma el ingreso ni la clase.</p><% } %>
<% if(asesoria.getEstado().equals("Aceptada")){ %><p class="form-text">Esta sesión se aceptó antes del proceso de confirmación por pago. Se conserva su historial; no se presume que exista un pago registrado.</p><% } %>
<% if(asesoria.isCancelacionSolicitada()){ %><p class="alert alert-info"><strong>Solicitud en revisión administrativa.</strong> <%=Html.escape(asesoria.getMotivoCancelacion())%>. La sesión conserva su estado hasta la resolución. Solicitar una devolución no significa que se haya transferido dinero.</p><% } %>
<% if(!asesoria.getAsistencia().isBlank()){ %><p><strong>Resultado:</strong> <%=Html.escape(asesoria.getAsistencia())%></p><% } %>
<% if(!asesoria.getComentario().isBlank()){ %><h3 class="h6">Seguimiento del profesor</h3><p class="tm-comment"><%=Html.escape(asesoria.getComentario())%></p><% } %>
<% if(ReglasTutoria.puedeEntrar(asesoria,ReglasTutoria.ahora())){ %><a class="btn btn-primary" href="<%=Html.escape(asesoria.getEnlaceClase())%>" target="_blank" rel="noopener noreferrer">Entrar a la clase <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i></a><% }else if(ReglasTutoria.confirmada(asesoria)&&asesoria.getEnlaceClase().isBlank()){ %><p class="form-text">El profesor aún no ha publicado el enlace de la clase.</p><% } %>
</div></section>
<section class="card mb-4"><div class="card-body"><h2 class="tm-section-title">Pago del alumno</h2><p><strong><%=estadoPago==null?"Sin ingreso registrado":Html.escape(estadoPago.estado())%></strong></p><p class="form-text">El pago del alumno, la realización de la clase y el pago al profesor se registran por separado.</p><% if(actorRol!=Rol.DOCENTE){ %><a class="btn btn-outline-primary" href="<%=contexto%>/pago.jsp?id=<%=asesoriaId%>"><%=actorRol==Rol.ADMIN?"Revisar pago y devoluciones":"Ver pago y enviar comprobante"%></a><% } %></div></section>
<% if(cambio!=null){boolean abierta=cambio.estado().equals("Pendiente"); %><section class="card mb-4"><div class="card-body"><h2 class="tm-section-title">Propuesta de nuevo horario</h2><p><strong><%=cambio.fecha()%> · <%=cambio.hora()%></strong> (Lima) · <%=Html.escape(cambio.estado())%></p><p><%=Html.escape(cambio.motivo())%></p><p class="form-text">Alumno: <%=cambio.alumno()?"aceptó":"sin aceptación"%> · Profesor: <%=cambio.docente()?"aceptó":"sin aceptación"%></p>
<% if(abierta){ %><p class="alert alert-info">El horario original se conserva. La propuesta no reserva el nuevo horario hasta que ambos acepten. Deben responder antes de <%=cambio.vence()%> (Lima).</p>
<% if(acciones.contains("aceptar_cambio")&&((actorRol==Rol.ALUMNO&&!cambio.alumno())||(actorRol==Rol.DOCENTE&&!cambio.docente()))){ %><%=abrirAccion(contexto,asesoriaId,"aceptar_cambio",csrf)%><input type="hidden" name="version" value="<%=cambio.version()%>"><button class="btn btn-primary mb-3" type="submit">Aceptar nuevo horario</button></form><% } %>
<% if(acciones.contains("rechazar_cambio")){ %><details class="tm-action-details"><summary>Rechazar o retirar propuesta</summary><%=abrirAccion(contexto,asesoriaId,"rechazar_cambio",csrf)%><input type="hidden" name="version" value="<%=cambio.version()%>"><%=motivoAccion("rechazar_cambio","Motivo",accionDatos,850)%><button class="btn btn-outline-danger" type="submit">Cerrar propuesta y conservar horario</button></form></details><% } %>
<% } %></div></section><% } %>
<section class="card"><div class="card-body"><h2 class="tm-section-title">Historial de la asesoría</h2><% if(eventos.isEmpty()){ %><p class="text-muted small">Registro anterior a este seguimiento. No se han generado movimientos nuevos.</p><% } %><ol class="tm-session-history"><% for(var evento:eventos){ %><li><span><%=evento.fecha()%> (Lima) · <%=rolEvento(evento.rol())%></span><p><%=Html.escape(evento.detalle())%></p></li><% } %></ol></div></section>
</div><aside><section class="card"><div class="card-body"><h2 class="tm-section-title">Gestionar asesoría</h2>
<% if(acciones.isEmpty()){ %><p class="text-muted small">No hay acciones disponibles para tu cuenta en este estado.</p><% } %>
<% for(String accion:acciones){if(accion.equals("aceptar_cambio")||accion.equals("rechazar_cambio")||(accion.equals("proponer")&&cambio!=null&&cambio.estado().equals("Pendiente")))continue; %>
<details class="tm-action-details"><summary><%=tituloAccion(accion,solicitarCancelacion)%></summary><%=abrirAccion(contexto,asesoriaId,accion,csrf)%>
<% if(accion.equals("enlace")){ %><label class="form-label" for="enlace">Enlace HTTPS de la videollamada</label><input class="form-control mb-3" name="valor" id="enlace" type="url" maxlength="1000" required value="<%=Html.escape(accionDatos.getOrDefault("accion","").equals("enlace")?accionDatos.getOrDefault("valor",""):asesoria.getEnlaceClase())%>">
<% }else{if(accion.equals("proponer")){ %><p class="form-text">Se mantiene el mismo profesor, curso, duración, precio y pago. Ambos participantes deben aceptar.</p><label class="form-label" for="nueva-fecha">Nueva fecha (Lima)</label><input class="form-control mb-3" id="nueva-fecha" name="fecha" type="date" min="<%=ReglasTutoria.ahora().toLocalDate()%>" required value="<%=Html.escape(accionDatos.getOrDefault("fecha",""))%>"><label class="form-label" for="nueva-hora">Nueva hora (Lima)</label><input class="form-control mb-3" id="nueva-hora" name="hora" type="time" required value="<%=Html.escape(accionDatos.getOrDefault("hora",""))%>">
<% }if(accion.equals("incidencia")){ %><label class="form-label" for="resultado">Qué ocurrió</label><select class="form-select mb-3" id="resultado" name="valor"><% if(actorRol==Rol.DOCENTE){ %><option>Alumno ausente</option><% } %><option>Profesor ausente</option><option>Problema técnico</option></select><% }if(accion.equals("resolver")){ %><label class="form-label" for="resolucion">Resultado verificado</label><select class="form-select mb-3" id="resolucion" name="valor"><option value="Cancelada">Cancelar sesión</option><option value="Completada">La asesoría sí se realizó</option></select><% } %>
<%=motivoAccion(accion,accion.equals("completar")?"Qué trabajaron y qué recomiendas practicar":accion.equals("comentario")?"Comentario para el alumno":"Explica el motivo",accionDatos,accion.equals("completar")||accion.equals("comentario")?500:850)%>
<% if(accion.equals("cancelar")){ %><p class="form-text"><%=solicitarCancelacion?"La solicitud se enviará a administración para revisión.":"La decisión queda registrada."%> Esta acción no registra una devolución de dinero.</p><% } %><% } %>
<button class="btn <%=accion.equals("cancelar")?"btn-outline-danger":"btn-primary"%>" type="submit"><%=accion.equals("cancelar")&&solicitarCancelacion?"Enviar a administración":"Guardar decisión"%></button></form></details><% } %>
</div></section></aside></div></div></main><%@ include file="component/footer.jsp" %></body></html>