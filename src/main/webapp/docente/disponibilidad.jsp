<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.tme.dao.OfertaDAO,com.tme.db.DBConnection,com.tme.modal.Docente,com.tme.security.Html" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<% int ofertaDocenteId=((Docente)session.getAttribute("docenteObj")).getId();OfertaDAO oferta=new OfertaDAO(DBConnection.getConn());var asignados=oferta.cursosDocente(ofertaDocenteId);String disponibilidadAction="/docenteDisponibilidad"; %>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Mi disponibilidad | TeachMate</title><%@ include file="../component/allcss.jsp" %></head><body><%@ include file="../component/navbar.jsp" %><main id="contenido" class="tm-main" tabindex="-1"><%@ include file="../component/messages.jsp" %><div class="container p-3"><div class="tm-page-heading"><div><p class="tm-eyebrow">Organiza tu agenda</p><h1 class="tm-page-title">Mi disponibilidad</h1><p>Publica las fechas y horas en las que puedes atender asesorías individuales.</p></div></div>
<section class="card mb-4"><div class="card-body"><h2 class="tm-section-title">Mis cursos y tarifas</h2><p class="text-muted small">Las asignaciones y los importes los gestiona el administrador.</p><% if(asignados.isEmpty()){ %><p class="tm-empty">Todavía no tienes cursos asignados.</p><% }for(var curso:oferta.cursos(false)){if(!asignados.contains(curso.id()))continue; %><div class="tm-offer-item"><div><strong><%=Html.escape(curso.nombre())%> <%=curso.activo()?"":"· Inactivo"%></strong><% for(var tarifa:oferta.tarifas(curso.id(),true)){ %><span><%=com.tme.service.TiempoVisible.duracion(tarifa.minutos())%> · S/ <%=tarifa.precio()%> · Tu parte: <%=tarifa.porcentaje()%> %</span><% } %></div></div><% } %></div></section>
<%@ include file="../WEB-INF/disponibilidad.jsp" %></div></main><%@ include file="../component/footer.jsp" %></body></html>
