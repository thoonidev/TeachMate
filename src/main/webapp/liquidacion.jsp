<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.tme.dao.LiquidacionesDAO,com.tme.db.DBConnection,com.tme.modal.Docente,com.tme.service.ReglasTutoria,com.tme.service.ReglasTutoria.Rol,com.tme.security.Html,java.time.*,java.math.*" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%!
private String fechaCierre(LocalDateTime f){return f==null?"—":f.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"));}
private String formCierre(String ctx,int id,int version,String accion,String csrf){return "<form method=\"post\" action=\""+Html.escape(ctx)+"/gestionarLiquidacion\"><input type=\"hidden\" name=\"csrfToken\" value=\""+Html.escape(csrf)+"\"><input type=\"hidden\" name=\"id\" value=\""+id+"\"><input type=\"hidden\" name=\"version\" value=\""+version+"\"><input type=\"hidden\" name=\"accion\" value=\""+accion+"\">";}
%>
<%
int cierreId;try{cierreId=Integer.parseInt(request.getParameter("id"));if(cierreId<1)throw new NumberFormatException();}catch(RuntimeException e){response.sendError(400);return;}
boolean cierreAdmin=session.getAttribute("adminObj")!=null;Rol cierreRol=cierreAdmin?Rol.ADMIN:Rol.DOCENTE;int cierreActor=cierreAdmin?0:((Docente)session.getAttribute("docenteObj")).getId();
var cierreDao=new LiquidacionesDAO(DBConnection.getConn());var cierre=cierreDao.obtener(cierreId,cierreActor,cierreRol);if(cierre==null){response.sendError(404);return;}
var cierreLineas=cierreDao.lineas(cierreId,cierreActor,cierreRol);var cierreEventos=cierreDao.historial(cierreId,null,cierreActor,cierreRol);String cierreCtx=request.getContextPath(),cierreCsrf=(String)session.getAttribute("csrfToken");
BigDecimal cierreCobro=new BigDecimal("0.00"),cierreDevolucion=new BigDecimal("0.00");for(var l:cierreLineas)if(l.ajuste()==null){cierreCobro=cierreCobro.add(l.precio());cierreDevolucion=cierreDevolucion.add(l.devuelto());}
%>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Liquidación #<%=cierreId%> | TeachMate</title><%@ include file="component/allcss.jsp" %></head><body><%@ include file="component/navbar.jsp" %><main id="contenido" class="tm-main" tabindex="-1"><%@ include file="component/messages.jsp" %><div class="container p-3"><div class="tm-page-heading"><div><p class="tm-eyebrow">Liquidación #<%=cierreId%></p><h1 class="tm-page-title"><%=Html.escape(cierre.nombre())%></h1><p>Corte hasta <%=cierre.corte()%> · Pago previsto: <%=cierre.previsto()%> (Lima)</p></div><a class="btn btn-outline-secondary" href="<%=cierreCtx+(cierreAdmin?"/admin/liquidaciones.jsp?docente="+cierre.docente():"/docente/ingresos.jsp")%>">Volver a ingresos</a></div>
<div class="tm-session-layout"><div><section class="card mb-4"><div class="card-body"><h2 class="tm-section-title">Estado del cierre</h2><p class="tm-payment-state"><%=cierre.estado()%> · S/ <%=cierre.total()%></p><dl class="tm-session-summary"><dt>Preparado</dt><dd><%=fechaCierre(cierre.creado())%> (Lima)</dd><dt>Ingresos de las sesiones incluidas</dt><dd>S/ <%=cierreCobro%></dd><dt>Devoluciones al preparar el cierre</dt><dd>S/ <%=cierreDevolucion%></dd><dt>Total para el profesor</dt><dd>S/ <%=cierre.total()%></dd><dt>Retención del equipo en este cierre</dt><dd>S/ <%=cierreCobro.subtract(cierreDevolucion).subtract(cierre.total())%></dd></dl><p class="form-text">La retención incluye los ajustes aceptados de este cierre, que pueden corresponder a sesiones pagadas anteriormente. No representa utilidad neta ni sueldo administrativo. Los importes del cierre se conservan aunque haya devoluciones posteriores.</p>
<% if(cierre.estado().equals("Pagada")){ %><h3 class="h6">Transferencia externa registrada</h3><dl class="tm-session-summary"><dt>Fecha real</dt><dd><%=fechaCierre(cierre.transferida())%> (Lima)</dd><dt>Referencia</dt><dd><%=Html.escape(cierre.referencia())%></dd><dt>Destino registrado</dt><dd><%=Html.escape(cierre.destino())%></dd></dl><% }else if(cierre.estado().equals("Pendiente")){ %><p class="alert alert-info">Preparar el cierre no significa que el profesor haya recibido dinero. Antes de registrar la transferencia se revisan nuevamente sus sesiones, pagos y devoluciones.</p><% } %><% if(!cierre.motivo().isBlank()){ %><p><strong>Motivo registrado:</strong> <%=Html.escape(cierre.motivo())%></p><% } %></div></section>
<section class="card mb-4"><div class="card-body"><h2 class="tm-section-title">Sesiones y ajustes incluidos</h2><ul class="tm-payment-list"><% for(var l:cierreLineas){ %><li><strong><%=l.tipo()%> · <%=Html.escape(l.curso())%> · S/ <%=l.importe()%></strong><p><a href="<%=cierreCtx%>/asesoria.jsp?id=<%=l.tutoria()%>">Asesoría #<%=l.tutoria()%></a> · <%=l.fecha()%></p><p class="form-text">Precio S/ <%=l.precio()%> · Porcentaje histórico <%=l.porcentaje()%> % · Devuelto al preparar: S/ <%=l.devuelto()%><br><%=Html.escape(l.descripcion())%></p></li><% } %></ul></div></section>
<section class="card"><div class="card-body"><h2 class="tm-section-title">Historial del cierre</h2><ol class="tm-session-history"><% for(var e:cierreEventos){ %><li><span><%=fechaCierre(e.fecha())%> (Lima) · Administración</span><p><%=Html.escape(e.detalle())%></p></li><% } %></ol></div></section></div>
<aside><section class="card"><div class="card-body"><h2 class="tm-section-title"><%=cierreAdmin?"Gestionar liquidación":"Seguimiento"%></h2><% if(cierreAdmin&&cierre.estado().equals("Pendiente")){ %>
<% if(cierre.total().signum()>0){ %><details class="tm-action-details"><summary>Registrar transferencia realizada</summary><%=formCierre(cierreCtx,cierreId,cierre.version(),"pagar",cierreCsrf)%><p class="form-text">Realiza la transferencia fuera de TeachMate y verifica el destino con el profesor. Registra los datos solo después de ejecutarla.</p><label class="form-label" for="importe-cierre">Importe transferido (S/)</label><input class="form-control mb-3" type="number" step="0.01" min="0.01" name="importe" id="importe-cierre" required><label class="form-label" for="destino-cierre">Cuenta o medio de destino</label><input class="form-control mb-3" name="destino" id="destino-cierre" maxlength="200" required><label class="form-label" for="referencia-cierre">Referencia de la transferencia</label><input class="form-control mb-3" name="referencia" id="referencia-cierre" maxlength="100" required><label class="form-label" for="fecha-cierre">Fecha y hora real (Lima)</label><input class="form-control mb-3" type="datetime-local" name="fecha" id="fecha-cierre" min="<%=cierre.creado().withSecond(0).withNano(0)%>" max="<%=ReglasTutoria.ahora().withSecond(0).withNano(0)%>" required><button class="btn btn-primary" type="submit">Registrar transferencia al profesor</button></form></details><% }else{ %><details class="tm-action-details"><summary>Confirmar compensación sin transferencia</summary><%=formCierre(cierreCtx,cierreId,cierre.version(),"compensar",cierreCsrf)%><label class="form-label" for="motivo-compensar">Explica el saldo cero</label><textarea class="form-control mb-3" id="motivo-compensar" name="motivo" maxlength="850" required></textarea><button class="btn btn-primary" type="submit">Registrar compensación de saldo cero</button></form></details><% } %>
<details class="tm-action-details"><summary>Anular cierre pendiente</summary><%=formCierre(cierreCtx,cierreId,cierre.version(),"anular",cierreCsrf)%><p class="form-text">Solo si todavía no transferiste el dinero. El detalle y el motivo se conservan; las sesiones y ajustes vuelven a estar disponibles para preparar otro cierre.</p><label class="form-label" for="motivo-anular">Motivo de la anulación</label><textarea class="form-control mb-3" id="motivo-anular" name="motivo" maxlength="850" required></textarea><button class="btn btn-outline-danger" type="submit">Anular cierre sin transferencia</button></form></details>
<% }else{ %><p class="text-muted small">Las transferencias registradas conservan su historial. Una devolución posterior se revisa como ajuste separado; no reescribe este cierre.</p><% } %></div></section></aside></div></div></main><%@ include file="component/footer.jsp" %></body></html>
