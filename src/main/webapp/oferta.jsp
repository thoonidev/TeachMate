<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.tme.dao.OfertaDAO,com.tme.dao.DocenteDAO,com.tme.db.DBConnection,com.tme.security.Html,com.tme.modal.User,java.util.List" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<% var condiciones=new com.tme.dao.ConfiguracionReservasDAO(DBConnection.getConn()).obtener();OfertaDAO oferta=new OfertaDAO(DBConnection.getConn());var cursos=oferta.cursos(true);int cursoId=0,tarifaId=0,docenteFiltro=0;
try{if(request.getParameter("cursoId")!=null)cursoId=Integer.parseInt(request.getParameter("cursoId"));if(request.getParameter("tarifaId")!=null)tarifaId=Integer.parseInt(request.getParameter("tarifaId"));if(request.getParameter("docenteId")!=null)docenteFiltro=Integer.parseInt(request.getParameter("docenteId"));}catch(RuntimeException e){response.sendError(400);return;}
OfertaDAO.Curso elegido=null;for(var c:cursos)if(c.id()==cursoId)elegido=c;
var tarifas=elegido==null?List.<OfertaDAO.Tarifa>of():oferta.tarifas(cursoId,true);OfertaDAO.Tarifa elegida=null;for(var t:tarifas)if(t.id()==tarifaId)elegida=t;if(elegida==null&&!tarifas.isEmpty())elegida=tarifas.get(0);
int alumnoId=session.getAttribute("userObj") instanceof User alumno?alumno.getId():0;
%>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Cursos, profesores y horarios | TeachMate</title><%@ include file="component/allcss.jsp" %></head><body><%@ include file="component/navbar.jsp" %><main id="contenido" class="tm-main" tabindex="-1"><%@ include file="component/messages.jsp" %><div class="container p-3"><div class="tm-page-heading"><div><p class="tm-eyebrow">Encuentra tu asesoría</p><h1 class="tm-page-title">Curso, profesor y horario</h1><p>Consulta precios y horarios disponibles. Todos los importes están en soles y las horas corresponden a Lima.</p></div></div>
<% if(!condiciones.completa()||!new com.tme.dao.ConfiguracionPagosDAO(DBConnection.getConn()).obtener().completa()){ %><p class="alert alert-info">El equipo está configurando las condiciones de reserva y cobro. Puedes consultar los cursos; los horarios se habilitarán al completar la configuración.</p><% } %><% if(docenteFiltro>0){ %><p><a href="oferta.jsp">Consultar todos los profesores</a></p><% } %><section class="card mb-4"><div class="card-body"><form method="get" class="row g-3"><% if(docenteFiltro>0){ %><input type="hidden" name="docenteId" value="<%=docenteFiltro%>"><% } %><div class="col-md-5"><label class="form-label" for="cursoId">Curso</label><select class="form-select" id="cursoId" name="cursoId" required><option value="">Selecciona un curso</option><% for(var c:cursos){if(docenteFiltro>0&&!oferta.cursosDocente(docenteFiltro).contains(c.id()))continue; %><option value="<%=c.id()%>" <%=c.id()==cursoId?"selected":""%>><%=Html.escape(c.nombre())%></option><% } %></select></div>
<div class="col-md-4"><label class="form-label" for="tarifaId">Duración y precio</label><select class="form-select" id="tarifaId" name="tarifaId"><option value="0">Ver opciones del curso</option><% for(var t:tarifas){ %><option value="<%=t.id()%>" <%=elegida!=null&&t.id()==elegida.id()?"selected":""%>><%=t.minutos()%> minutos · S/ <%=t.precio()%></option><% } %></select></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary" type="submit">Ver horarios</button></div></form></div></section>
<% if(elegido==null){ %><p class="tm-empty">Selecciona el curso que necesitas reforzar.</p><% }else{ %><h2 class="tm-section-title"><%=Html.escape(elegido.nombre())%></h2><p class="text-muted"><%=Html.escape(elegido.descripcion())%></p>
<% if(elegida==null){ %><p class="alert alert-info">Este curso todavía no tiene tarifas habilitadas. No se pueden enviar nuevas solicitudes.</p><% }else{boolean hayProfesor=false; %><p class="text-muted small">Duración: <%=elegida.minutos()%> minutos · Precio total: S/ <%=elegida.precio()%>. Cambia la duración y pulsa Ver horarios para consultar otra opción.</p><div class="tm-teacher-grid">
<% for(var profesor:new DocenteDAO(DBConnection.getConn()).getActiveDocentes()){if(docenteFiltro>0&&profesor.getId()!=docenteFiltro)continue;if(!oferta.cursosDocente(profesor.getId()).contains(cursoId))continue;hayProfesor=true;var horarios=oferta.horarios(profesor.getId(),elegida.minutos(),alumnoId); %>
<article class="tm-teacher-card"><h3><%=Html.escape(profesor.getNombre())%></h3><p class="tm-teacher-subject"><%=Html.escape(profesor.getCalificacion())%></p><p class="tm-teacher-qualification"><%=Html.escape(profesor.getPresentacion())%></p><p class="small text-muted"><%=Html.escape(profesor.getNiveles())%></p><h4 class="h6">Próximos horarios disponibles</h4><p class="form-text">Hasta 12 opciones. El horario se comprueba de nuevo al enviar.</p><div class="tm-slot-list"><% if(horarios.isEmpty()){ %><p class="text-muted small">No hay horarios publicados para esta duración.</p><% }for(var horario:horarios){ %><a href="reg_tutoria.jsp?cursoId=<%=cursoId%>&amp;tarifaId=<%=elegida.id()%>&amp;docenteId=<%=profesor.getId()%>&amp;fecha=<%=horario.fecha()%>&amp;hora=<%=horario.inicio()%>" class="tm-slot"><span><%=horario.fecha()%></span><strong><%=horario.inicio()%></strong></a><% } %></div></article><% } %></div><% if(!hayProfesor){ %><p class="tm-empty">No hay profesores activos asignados a este curso.</p><% } %><% } } %>
</div></main><%@ include file="component/footer.jsp" %></body></html>