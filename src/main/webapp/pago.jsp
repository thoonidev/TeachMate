<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.tme.dao.*,com.tme.db.DBConnection,com.tme.modal.*,com.tme.service.ReglasTutoria,com.tme.service.ReglasTutoria.Rol,com.tme.security.Html,java.util.*,java.time.*,java.math.BigDecimal" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%!
private String fechaPago(LocalDateTime v){return v==null?"—":v.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"));}
private String formularioPago(String ctx,int id,int version,String accion,String csrf,boolean archivo){return "<form method=\"post\" action=\""+Html.escape(ctx)+"/gestionarPago\""+(archivo?" enctype=\"multipart/form-data\"":"")+"><input type=\"hidden\" name=\"csrfToken\" value=\""+Html.escape(csrf)+"\"><input type=\"hidden\" name=\"id\" value=\""+id+"\"><input type=\"hidden\" name=\"version\" value=\""+version+"\"><input type=\"hidden\" name=\"accion\" value=\""+accion+"\">";}
%>
<%
int pagoId;try{pagoId=Integer.parseInt(request.getParameter("id"));if(pagoId<1)throw new NumberFormatException();}catch(RuntimeException e){response.sendError(400);return;}
boolean pagoAdmin=session.getAttribute("adminObj")!=null;Rol pagoRol=pagoAdmin?Rol.ADMIN:Rol.ALUMNO;
int pagoActor=pagoAdmin?0:((User)session.getAttribute("userObj")).getId();
var pagoGestion=new GestionAsesoriasDAO(DBConnection.getConn());var pagoSesion=pagoGestion.obtener(pagoId,pagoActor,pagoRol);if(pagoSesion==null){response.sendError(404);return;}
var pagoDao=new PagosDAO(DBConnection.getConn());var pago=pagoDao.obtener(pagoId);var instrucciones=new ConfiguracionPagosDAO(DBConnection.getConn()).condiciones(pagoId);
var devoluciones=pagoDao.devoluciones(pagoId);var recibos=pagoDao.comprobantes(pagoId);var pagoEventos=pagoDao.historial(pagoId);var ahoraPago=ReglasTutoria.ahora();
int pagoVersion=pago==null?0:pago.version();String pagoCtx=request.getContextPath(),pagoCsrf=(String)session.getAttribute("csrfToken");
boolean pagoAbierto=pagoSesion.getEstado().equals("Pendiente de pago")&&ReglasTutoria.vigente(pagoSesion,ahoraPago)&&!pagoSesion.isCancelacionSolicitada();
boolean puedeRegistrar=pagoAbierto&&(pago==null||pago.estado().equals("Observado"))&&instrucciones.completa();
boolean puedeTardio=pagoAdmin&&pagoSesion.getPrecio()!=null&&pagoSesion.getVencePago()!=null&&Set.of("Cancelada","Rechazada","Vencida","Incidencia").contains(pagoSesion.getEstado())&&(pago==null||pago.estado().equals("Observado"));
Map<String,String> pagoDatos=new HashMap<>();Object pagoPrevio=session.getAttribute("pagoForm");session.removeAttribute("pagoForm");if(pagoPrevio instanceof Map<?,?> mapa&&Integer.toString(pagoId).equals(mapa.get("id")))for(var e:mapa.entrySet())if(e.getKey() instanceof String k&&e.getValue() instanceof String v)pagoDatos.put(k,v);
%>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Pago de asesoría #<%=pagoId%> | TeachMate</title><%@ include file="component/allcss.jsp" %></head><body><%@ include file="component/navbar.jsp" %><main id="contenido" class="tm-main" tabindex="-1"><%@ include file="component/messages.jsp" %><div class="container p-3">
<div class="tm-page-heading"><div><p class="tm-eyebrow">Pago del alumno · Asesoría #<%=pagoId%></p><h1 class="tm-page-title"><%=Html.escape(pagoSesion.getCursoNombre()==null?"Pago de asesoría":pagoSesion.getCursoNombre())%></h1><p><%=Html.escape(pagoSesion.getNombre())%> · <%=Html.escape(pagoSesion.getFtutoria())%> · <%=Html.escape(pagoSesion.getHorario())%> (Lima)</p></div><a class="btn btn-outline-secondary" href="<%=pagoCtx%>/asesoria.jsp?id=<%=pagoId%>">Ver asesoría</a></div>
<div class="tm-session-layout"><div><section class="card mb-4"><div class="card-body"><h2 class="tm-section-title">Estado del pago</h2><p class="tm-payment-state"><%=pago!=null?Html.escape(pago.estado()):pagoAbierto?"Pendiente de registro":"Sin ingreso registrado"%></p><dl class="tm-session-summary"><dt>Precio de la reserva</dt><dd><%=pagoSesion.getPrecio()==null?"Registro anterior sin tarifa":"S/ "+pagoSesion.getPrecio()%></dd><dt>Asesoría</dt><dd><%=Html.escape(EstadoTutoria.desdeValor(pagoSesion.getEstado()).getEtiqueta())%></dd><% if(pago!=null&&pago.validado()!=null){ %><dt>Ingreso validado</dt><dd>S/ <%=pago.importe()%> · <%=fechaPago(pago.validado())%></dd><dt>Devuelto</dt><dd>S/ <%=pagoDao.devuelto(pagoId)%></dd><dt>Saldo del ingreso</dt><dd>S/ <%=pago.importe().subtract(pagoDao.devuelto(pagoId))%></dd><% } %></dl>
<% if(pagoSesion.getEstado().equals("Pendiente de pago")&&pagoSesion.getRevisionPrevista()!=null){ %><p class="alert <%=pagoSesion.isPagoRevision()&&!ahoraPago.isBefore(pagoSesion.getRevisionPrevista())?"alert-warning":"alert-info"%>">Revisión administrativa prevista a más tardar: <strong><%=fechaPago(pagoSesion.getRevisionPrevista())%></strong> (Lima). <% if(pagoSesion.getCalendarioRevision()!=null){ %>Atención: <%=Html.escape(pagoSesion.getCalendarioRevision().descripcion())%>.<% } %> Adjuntar el comprobante no confirma la clase.</p><% } %>
<% if(pagoSesion.isCancelacionSolicitada()){ %><p class="alert alert-info">Solicitud en revisión administrativa: <%=Html.escape(pagoSesion.getMotivoCancelacion())%>. La sesión y el dinero conservan su estado hasta la resolución.</p><% } %>
<% if(pago!=null&&pago.estado().equals("En revisión")){ %><p class="alert alert-info">Comprobante recibido el <%=fechaPago(pago.enviado())%> (Lima). Administración debe verificar el ingreso real. <% if(pagoSesion.getEstado().equals("Pendiente de pago")){ %>El horario se conserva mientras se revisa, hasta el inicio de la clase.<% }else{ %>La reserva no se reactiva automáticamente; administración debe resolver el caso.<% } %></p><% if(pagoAdmin&&(pagoSesion.getEstado().equals("Incidencia")||(pagoSesion.getRevisionPrevista()!=null&&!ahoraPago.isBefore(pagoSesion.getRevisionPrevista()))||(ReglasTutoria.inicio(pagoSesion)!=null&&ReglasTutoria.inicio(pagoSesion).isBefore(ahoraPago.plusHours(2))))){ %><p class="alert alert-warning">Revisión prioritaria: el plazo previsto de revisión venció, la clase está próxima o ya comenzó. Comprueba el ingreso antes de resolver la sesión.</p><% } %><% } %>
<% if(pago!=null&&pago.estado().equals("Observado")){ %><p class="alert alert-warning"><strong>Qué debes corregir:</strong> <%=Html.escape(pago.observacion())%><br><%=pago.corregir()==null?"Contacta a administración; no hay un nuevo plazo de reserva.":"Plazo de corrección: "+fechaPago(pago.corregir())+" (Lima)."%></p><% } %>
<% if(pagoAbierto&&!pagoSesion.isPagoRevision()){ %><p class="form-text">Envía el comprobante antes del <%=fechaPago(pagoSesion.getVencePago())%> (Lima). Si vence, se libera el horario.</p><% } %>
<% if(!pagoAbierto&&(pago==null||pago.validado()==null)){ %><p class="form-text">Esta pantalla no acredita una deuda. Si ya realizaste una transferencia fuera de plazo, contacta a administración para revisar su devolución o una nueva reserva; el horario anterior no se recupera automáticamente.</p><% } %>
<% if(pago!=null&&pago.validado()!=null&&!Set.of("Confirmada","Completada","Aceptada").contains(pagoSesion.getEstado())&&!pago.estado().equals("Devuelto")){ %><p class="alert alert-warning">Existe un ingreso validado para una sesión sin confirmar o cancelada. Administración debe resolver el destino del dinero. No se ha registrado un pago al profesor.</p><% } %>
</div></section>
<% if(puedeRegistrar){ %><section class="card mb-4"><div class="card-body"><h2 class="tm-section-title">Cómo pagar</h2><dl class="tm-session-summary"><dt>Medio</dt><dd><%=Html.escape(instrucciones.medio())%></dd><dt>Titular del equipo</dt><dd><%=Html.escape(instrucciones.titular())%></dd><dt>Cuenta o número</dt><dd><%=Html.escape(instrucciones.destino())%></dd><dt>Importe exacto</dt><dd>S/ <%=pagoSesion.getPrecio()%></dd></dl><p class="tm-comment"><%=Html.escape(instrucciones.instrucciones())%></p><p class="form-text">Realiza el pago fuera de TeachMate. Nunca compartas contraseñas ni códigos de seguridad. Adjuntar el comprobante no confirma la clase.</p></div></section><% } %>
<% if(!recibos.isEmpty()){ %><section class="card mb-4"><div class="card-body"><h2 class="tm-section-title">Comprobantes privados</h2><ul class="tm-payment-list"><% for(var recibo:recibos){ %><li><strong><%=Html.escape(recibo.medio())%> · <%=Html.escape(recibo.referencia())%></strong><p>Operación: <%=fechaPago(recibo.operado())%> · Recibido: <%=fechaPago(recibo.registrado())%> (Lima)</p><a href="<%=pagoCtx%>/comprobantePago?id=<%=recibo.id()%>">Descargar comprobante #<%=recibo.version()%></a></li><% } %></ul><p class="form-text">Solo el alumno de esta reserva y administración pueden consultar los archivos.</p></div></section><% } %>
<% if(!devoluciones.isEmpty()){ %><section class="card mb-4"><div class="card-body"><h2 class="tm-section-title">Devoluciones</h2><ul class="tm-payment-list"><% for(var d:devoluciones){ %><li><strong>S/ <%=d.importe()%> · <%=d.ejecutada()==null?"Pendiente de transferencia":"Transferencia registrada"%></strong><p><%=Html.escape(d.motivo())%></p><p class="form-text">Aprobada: <%=fechaPago(d.aprobada())%> (Lima)<% if(d.ejecutada()!=null){ %><br>Ejecutada: <%=fechaPago(d.ejecutada())%> (Lima) · Referencia: <%=Html.escape(d.referencia())%><% } %></p></li><% } %></ul></div></section><% } %>
<section class="card"><div class="card-body"><h2 class="tm-section-title">Historial del pago</h2><% if(pagoEventos.isEmpty()){ %><p class="text-muted small">Todavía no hay movimientos de dinero registrados.</p><% } %><ol class="tm-session-history"><% for(var e:pagoEventos){ %><li><span><%=fechaPago(e.fecha())%> (Lima) · <%=e.rol().equals("ADMIN")?"Administración":"Alumno"%></span><p><%=Html.escape(e.detalle())%></p></li><% } %></ol></div></section>
</div><aside><section class="card"><div class="card-body"><h2 class="tm-section-title"><%=pagoAdmin?"Gestionar pago":"Tu siguiente paso"%></h2>
<% if(puedeRegistrar||puedeTardio){ %><details class="tm-action-details" <%=puedeRegistrar?"open":""%>><summary><%=puedeTardio?"Registrar ingreso fuera de plazo":"Enviar comprobante"%></summary><%=formularioPago(pagoCtx,pagoId,pagoVersion,"registrar",pagoCsrf,true)%><% if(puedeTardio){ %><input type="hidden" name="tardio" value="si"><p class="form-text">No recupera el horario ni confirma una sesión cerrada. El ingreso todavía debe validarse.</p><label class="form-label" for="motivo-tardio">Explica el ingreso fuera de plazo</label><textarea class="form-control mb-3" id="motivo-tardio" name="motivo" required maxlength="850"><%=Html.escape(pagoDatos.getOrDefault("motivo",""))%></textarea><% } %>
<label class="form-label" for="importe-recibo">Importe pagado (S/)</label><input class="form-control mb-3" id="importe-recibo" name="importe" type="number" min="0.01" step="0.01" required value="<%=Html.escape(pagoDatos.getOrDefault("importe",pagoSesion.getPrecio()==null?"":pagoSesion.getPrecio().toString()))%>"><label class="form-label" for="referencia-recibo">Número o referencia de operación</label><input class="form-control mb-3" id="referencia-recibo" name="referencia" required maxlength="100" value="<%=Html.escape(pagoDatos.getOrDefault("referencia",""))%>"><label class="form-label" for="fecha-recibo">Fecha y hora del pago (Lima)</label><input class="form-control mb-3" id="fecha-recibo" name="fecha" type="datetime-local" required max="<%=ahoraPago.withSecond(0).withNano(0)%>" value="<%=Html.escape(pagoDatos.getOrDefault("fecha",""))%>"><label class="form-label" for="comprobante">Comprobante PDF, JPG o PNG</label><input class="form-control mb-2" id="comprobante" name="comprobante" type="file" accept="application/pdf,image/jpeg,image/png" required><p class="form-text">Hasta 5 MB. Si corriges un envío, vuelve a adjuntar el archivo. No incluyas información ajena al pago.</p><button class="btn btn-primary w-100" type="submit">Enviar a revisión</button></form></details><% } %>
<% if(pagoAdmin&&pagoAbierto&&!instrucciones.completa()&&pago==null){ %><%=formularioPago(pagoCtx,pagoId,pagoVersion,"habilitar",pagoCsrf,false)%><p class="form-text">Reserva anterior sin instrucciones. Habilítalas usando la configuración actual, conservando su plazo.</p><button class="btn btn-primary" type="submit">Habilitar cobro de esta reserva</button></form><% } %>
<% if(pagoAdmin&&pago!=null&&pago.estado().equals("En revisión")){ %><details class="tm-action-details"><summary>Validar ingreso real</summary><%=formularioPago(pagoCtx,pagoId,pagoVersion,"validar",pagoCsrf,false)%><p class="form-text">Comprueba la operación en la cuenta del equipo. Una imagen por sí sola no acredita el ingreso. Confirmará la clase solo si el horario sigue vigente.</p><label class="form-label" for="importe-validar">Importe recibido en la cuenta (S/)</label><input class="form-control mb-3" id="importe-validar" name="importe" type="number" step="0.01" min="0.01" required><label class="form-label" for="motivo-validar">Cómo verificaste el ingreso</label><textarea class="form-control mb-3" name="motivo" id="motivo-validar" maxlength="850" required></textarea><button class="btn btn-primary" type="submit">Registrar ingreso verificado</button></form></details><details class="tm-action-details"><summary>Observar comprobante</summary><%=formularioPago(pagoCtx,pagoId,pagoVersion,"observar",pagoCsrf,false)%><label class="form-label" for="motivo-observar">Qué debe corregir el alumno</label><textarea class="form-control mb-3" id="motivo-observar" name="motivo" maxlength="850" required></textarea><p class="form-text">La corrección tendrá el plazo acordado en la reserva, sin superar el inicio de la clase. Una sesión cerrada no se reactiva.</p><button class="btn btn-outline-primary" type="submit">Enviar observación</button></form></details><% } %>
<% if(!pagoAdmin&&pago!=null&&pago.validado()!=null&&pago.estado().equals("Validado")&&!pagoSesion.isCancelacionSolicitada()){ %><details class="tm-action-details"><summary>Solicitar cancelación o devolución</summary><%=formularioPago(pagoCtx,pagoId,pagoVersion,"solicitar_devolucion",pagoCsrf,false)%><label class="form-label" for="motivo-solicitar">Explica tu solicitud</label><textarea class="form-control mb-3" id="motivo-solicitar" name="motivo" required maxlength="850"></textarea><p class="form-text">Administración revisará el caso. Enviar la solicitud no cancela la sesión ni devuelve dinero automáticamente.</p><button class="btn btn-outline-primary" type="submit">Enviar solicitud a administración</button></form></details><% } %>
<% if(pagoAdmin&&pago!=null&&pago.validado()!=null&&pago.estado().equals("Validado")){ %><details class="tm-action-details"><summary>Aprobar devolución</summary><%=formularioPago(pagoCtx,pagoId,pagoVersion,"aprobar_devolucion",pagoCsrf,false)%><p class="form-text">Primero resuelve la cancelación o incidencia desde la asesoría. Aprobar una devolución no realiza la transferencia. Puede ser total o parcial, con motivo registrado.</p><label class="form-label" for="importe-devolver">Importe a devolver (S/)</label><input class="form-control mb-3" id="importe-devolver" name="importe" type="number" min="0.01" step="0.01" max="<%=pago.importe().subtract(pagoDao.devuelto(pagoId))%>" required><label class="form-label" for="motivo-devolver">Motivo de la decisión</label><textarea class="form-control mb-3" id="motivo-devolver" name="motivo" required maxlength="850"></textarea><button class="btn btn-outline-primary" type="submit">Aprobar devolución pendiente</button></form></details><% } %>
<% if(pagoAdmin&&pago!=null&&pago.estado().equals("Devolución pendiente")){for(var d:devoluciones){if(d.ejecutada()!=null)continue; %><details class="tm-action-details" open><summary>Registrar transferencia de devolución</summary><%=formularioPago(pagoCtx,pagoId,pagoVersion,"ejecutar_devolucion",pagoCsrf,false)%><input type="hidden" name="devolucion" value="<%=d.id()%>"><p>Devolución aprobada: S/ <%=d.importe()%></p><label class="form-label" for="importe-transferir">Importe transferido (S/)</label><input class="form-control mb-3" id="importe-transferir" name="importe" type="number" min="0.01" step="0.01" required><label class="form-label" for="referencia-transferir">Referencia de la transferencia</label><input class="form-control mb-3" id="referencia-transferir" name="referencia" maxlength="100" required><label class="form-label" for="fecha-transferir">Fecha y hora real (Lima)</label><input class="form-control mb-3" id="fecha-transferir" name="fecha" type="datetime-local" min="<%=d.aprobada().withSecond(0).withNano(0)%>" max="<%=ahoraPago.withSecond(0).withNano(0)%>" required><button class="btn btn-primary" type="submit">Registrar devolución realizada</button></form></details><% }} %>
<% if(!puedeRegistrar&&!puedeTardio&&(pago==null||(!pagoAdmin&&!pago.estado().equals("Validado")))){ %><p class="text-muted small">Consulta el estado y el historial de esta página. <% if(!instrucciones.completa()&&pagoAbierto){ %>Administración debe completar las instrucciones antes del pago.<% } %></p><% } %>
<a class="btn btn-outline-secondary w-100 mt-3" href="<%=pagoCtx+(pagoAdmin?"/admin/pagos.jsp":"/mis_pagos.jsp")%>">Volver a pagos</a>
</div></section></aside></div></div></main><%@ include file="component/footer.jsp" %></body></html>
