<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Mi perfil | TeachMate</title><%@ include file="component/allcss.jsp" %></head><body><%@ include file="component/navbar.jsp" %><main id="contenido" class="tm-main" tabindex="-1"><%@ include file="component/messages.jsp" %><div class="container p-3"><div class="tm-page-heading"><div><p class="tm-eyebrow">Tu cuenta</p><h1 class="tm-page-title">Mi perfil</h1><p>Conserva tus datos de contacto para organizar tus asesorías.</p></div></div><section class="card tm-profile-card"><div class="card-body"><form method="post" action="guardarPerfilAlumno" class="row g-3"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><div class="col-12"><label class="form-label" for="nombre">Nombre completo</label><input class="form-control" name="nombre" id="nombre" maxlength="45" required autocomplete="name" value="<c:out value='${sessionScope.userObj.nombre}'/>"></div><div class="col-12"><label class="form-label" for="email">Correo electrónico</label><input class="form-control" id="email" type="email" readonly value="<c:out value='${sessionScope.userObj.email}'/>"></div><div class="col-12"><label class="form-label" for="telefono">Teléfono de contacto</label><input class="form-control" id="telefono" name="telefono" type="tel" maxlength="45" required autocomplete="tel" value="<c:out value='${sessionScope.userObj.telefono}'/>"></div><div class="col-12"><button class="btn btn-primary" type="submit">Guardar perfil</button><a class="btn btn-outline-secondary" href="change_password.jsp">Cambiar contraseña</a></div></form></div></section></div></main><%@ include file="component/footer.jsp" %></body></html>
